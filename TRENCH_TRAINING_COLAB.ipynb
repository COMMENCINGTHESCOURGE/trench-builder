# CELL 2: Melanin Spectrum Training Data
# ═══════════════════════════════════════════════════════
NAMED_BLACKS = {
    'Black Walnut': (0x1E, 0x13, 0x0B),
    'Black Mahogany': (0x25, 0x0C, 0x00),
    'Dark Mahogany': (0x4A, 0x18, 0x00),
    'Cafe Noir': (0x4B, 0x36, 0x21),
    'Bistre': (0x3D, 0x2B, 0x1F),
    'Dark Sienna': (0x3C, 0x14, 0x10),
    'Umber': (0x63, 0x51, 0x47),
    'Onyx': (0x35, 0x38, 0x39),
    'Jet': (0x0A, 0x0A, 0x0A),
    'Charcoal': (0x36, 0x33, 0x39),
    'Ebony': (0x55, 0x5D, 0x50),
    'Raisin Black': (0x23, 0x22, 0x27),
    'Eerie Black': (0x1B, 0x1B, 0x1B),
    'Licorice': (0x1A, 0x11, 0x10),
    'Night': (0x0C, 0x09, 0x0A),
}

def generate_melanin_spectrum(n=10000):
    data = []
    for _ in range(n):
        melanin = np.random.beta(2, 2)
        r = int(np.clip(30 + melanin * 200 + np.random.normal(0, 8), 5, 240))
        g = int(np.clip(25 + melanin * 140 + np.random.normal(0, 6), 5, 180))
        b = int(np.clip(20 + melanin * 80 + np.random.normal(0, 5), 3, 140))
        roughness = np.clip(0.25 + melanin * 0.2 + np.random.normal(0, 0.03), 0.1, 0.7)
        specular = np.clip(0.8 + melanin * 0.9 + np.random.normal(0, 0.1), 0.5, 2.5)
        subsurface = np.clip(1.5 - melanin * 1.4 + np.random.normal(0, 0.05), 0.05, 1.5)
        data.append({'melanin': float(melanin), 'color_rgb': [r/255, g/255, b/255],
                     'roughness': float(roughness), 'specular': float(specular),
                     'subsurface_mm': float(subsurface), 'key_light': float(1.0 + melanin * 3.0)})
    return data

melanin_data = generate_melanin_spectrum(10000)
print(f"✓ {len(melanin_data):,} melanin spectrum samples")

# ═══════════════════════════════════════════════════════
# CELL 3: Vanishing Point Perspective Grids
# ═══════════════════════════════════════════════════════
def generate_perspective_grids(n=5000):
    data = []
    for _ in range(n):
        vp_x = np.random.uniform(-1, 1); vp_y = np.random.uniform(-0.5, 0.5)
        vp_z = np.random.uniform(5, 50); horizon_y = np.random.uniform(-0.3, 0.3)
        n_lines = np.random.randint(4, 16)
        lines = []
        for i in range(n_lines):
            angle = np.random.uniform(0, np.pi*2); spread = np.random.uniform(0.1, 2.0)
            lines.append({'angle': float(angle), 'spread': float(spread)})
        data.append({'vp': [float(vp_x), float(vp_y), float(vp_z)],
                     'horizon': float(horizon_y), 'lines': lines,
                     'fov': float(np.random.uniform(30, 90)),
                     'cam_height': float(np.random.uniform(0.5, 3.0))})
    return data

vp_data = generate_perspective_grids(5000)
print(f"✓ {len(vp_data):,} vanishing point grids")

# ═══════════════════════════════════════════════════════
# CELL 4: BRDF Raytracing Samples
# ═══════════════════════════════════════════════════════
def generate_brdf(n=20000):
    data = []; materials = ['concrete','wood','metal','glass','fabric','stone','plastic','skin']
    for _ in range(n):
        mat = np.random.choice(materials)
        ti = np.random.uniform(0, np.pi/2); to = np.random.uniform(0, np.pi/2)
        roughness = np.random.beta(2, 2)
        metallic = np.random.random() if mat=='metal' else np.random.beta(1,5)*0.1
        albedo = np.random.uniform(0.02, 0.95)
        ht = (ti+to)/2; f0 = 0.04 + metallic*(albedo-0.04)
        fresnel = f0 + (1-f0)*(1-np.cos(ht))**5
        a2 = roughness**2
        ndf = a2/(np.pi*(np.cos(ht)**2*(a2-1)+1)**2+1e-8)
        g1i = 2/(1+np.sqrt(1+a2*np.tan(ti)**2)); g1o = 2/(1+np.sqrt(1+a2*np.tan(to)**2))
        geometry = g1i*g1o
        specular = fresnel*ndf*geometry/(4*np.cos(ti)*np.cos(to)+1e-8)
        diffuse = albedo/np.pi
        data.append({'material':mat,'roughness':float(roughness),'metallic':float(metallic),
                     'albedo':float(albedo),'reflectance':float(specular+diffuse)})
    return data

brdf_data = generate_brdf(20000)
print(f"✓ {len(brdf_data):,} BRDF samples")

