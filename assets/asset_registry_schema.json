{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/COMMENCINGTHESCOURGE/trench-builder/asset_registry_schema.json",
  "title": "Asset Registry",
  "description": "Schema for tracking every generated GLB asset with provenance: which script, which parameters, which validation result.",
  "type": "object",
  "required": ["version", "generated", "assets"],
  "properties": {
    "version": { "type": "string", "description": "Registry format version" },
    "generated": { "type": "string", "format": "date-time" },
    "project": { "type": "string", "description": "Project this registry belongs to" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source_script", "parameters", "glb"],
        "properties": {
          "name": { "type": "string", "description": "Human-readable asset name" },
          "source_script": { "type": "string", "description": "Generator script filename" },
          "source_sha256": { "type": "string", "description": "SHA256 of source script at generation time" },
          "generated_at": { "type": "string", "format": "date-time" },
          "parameters": {
            "type": "object",
            "description": "Key parameters used for generation"
          },
          "glb": {
            "type": "object",
            "required": ["filename", "sha256", "size_bytes"],
            "properties": {
              "filename": { "type": "string" },
              "sha256": { "type": "string", "description": "SHA256 of the GLB file" },
              "size_bytes": { "type": "integer" },
              "meshes": { "type": "integer" },
              "materials": { "type": "integer" },
              "nodes": { "type": "integer" }
            }
          },
          "validation": {
            "type": "object",
            "properties": {
              "status": { "enum": ["pass", "fail", "pending"] },
              "checks_passed": { "type": "integer" },
              "checks_total": { "type": "integer" },
              "last_validated": { "type": "string", "format": "date-time" }
            }
          },
          "deployment": {
            "type": "object",
            "properties": {
              "targets": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Projects this asset is deployed to"
              }
            }
          }
        }
      }
    }
  }
}
