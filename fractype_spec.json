    "json_ast": {"type":"fraction","num":{},"den":{}}
  },
  "applications": {
    "steganography": "numerator=public, denominator=hidden state",
    "dialogue_engine": "question above bar, answer below",
    "checkpoint_progress": "completed above bar, remaining below",
    "monofrac": "entire document as single nested fraction — reduction tree"
  },
